{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "Project",
  "options": {
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-"
  },
  "targets": {
    "Basis": {
      "deploymentTarget": "26.0",
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Basis",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ],
          "UIUserInterfaceStyle": "Dark",
          "NSCameraUsageDescription": "Basis uses the camera only in the background: on iPhone Duo it keeps the outer display showing the lesson, and on a probe iPhone it tracks motion in space. No camera images are shown or stored.",
          "NSLocalNetworkUsageDescription": "Basis connects the probe iPhone to the Duo so a real vector can stream into the lessons.",
          "NSBonjourServices": [
            "_basis-probe._tcp",
            "_basis-probe._udp"
          ],
          "NSMotionUsageDescription": "Basis reads how the whole Duo is rotated, so turning the coordinate frame changes a fixed point's coordinates."
        }
      },
      "platform": "iOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.b9290524-20a5-4d70-8b09-1920fca69e69",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1"
      },
      "sources": [
        {
          "path": "App"
        }
      ],
      "type": "application"
    },
    "BasisTests": {
      "type": "bundle.unit-test",
      "platform": "iOS",
      "deploymentTarget": "26.0",
      "sources": [
        {
          "path": "Tests"
        }
      ],
      "dependencies": [
        {
          "target": "Basis"
        }
      ],
      "settings": {
        "GENERATE_INFOPLIST_FILE": "YES",
        "SWIFT_VERSION": "5.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.b9290524-20a5-4d70-8b09-1920fca69e69.tests",
        "TARGETED_DEVICE_FAMILY": "1",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Basis.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Basis",
        "BUNDLE_LOADER": "$(TEST_HOST)"
      }
    }
  }
}